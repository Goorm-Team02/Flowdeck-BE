BACKEND_PORT=8080
BACKEND_IMAGE_TAG=latest

POSTGRES_DB=flowdeck
POSTGRES_USER=flowdeck
POSTGRES_PASSWORD=change-me

JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=1800
JWT_REFRESH_TOKEN_EXPIRATION_SECONDS=1209600

CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_EXPOSED_HEADERS=Authorization
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
