BACKEND_PORT=8080
BACKEND_IMAGE_TAG=latest

POSTGRES_DB=flowdeck
POSTGRES_USER=flowdeck
POSTGRES_PASSWORD=change-me

DB_URL=jdbc:postgresql://your-prod-db-endpoint.example:5432/flowdeck
DB_USERNAME=flowdeck
DB_PASSWORD=change-me

REDIS_HOST=your-prod-redis-endpoint.example
REDIS_PORT=6379
REDIS_SSL_ENABLED=true

JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=1800
JWT_REFRESH_TOKEN_EXPIRATION_SECONDS=1209600

CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example,https://*.your-preview-domain.example
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_EXPOSED_HEADERS=Authorization
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
