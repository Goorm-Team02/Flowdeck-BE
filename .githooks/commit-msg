#!/bin/sh

msg_file="$1"
first_line="$(sed -n '1p' "$msg_file")"
pattern='^\[(FEAT|FIX|HOTFIX|CHORE|DOCS|STYLE|REFACTOR|TEST|BUILD|CI|PERF)\] .+'

# Allow Git's autogenerated commit messages that are not practical to rewrite.
case "$first_line" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *)
    exit 0
    ;;
esac

if ! printf '%s\n' "$first_line" | grep -Eq "$pattern"; then
  echo "Invalid commit message format."
  echo "Use: [TYPE] subject"
  echo "Example: [FEAT] add login API"
  echo "Allowed types: FEAT, FIX, HOTFIX, CHORE, DOCS, STYLE, REFACTOR, TEST, BUILD, CI, PERF"
  exit 1
fi
