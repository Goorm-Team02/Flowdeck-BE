#!/bin/sh

zero_sha='0000000000000000000000000000000000000000'
branch_pattern='^(feature|fix|refactor|docs)/[a-z0-9]+(-[a-z0-9]+)*$'
failed=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_ref" ] && continue

  if [ "$local_sha" = "$zero_sha" ]; then
    continue
  fi

  case "$remote_ref" in
    refs/heads/main|refs/heads/develop)
      echo "Direct pushes to ${remote_ref#refs/heads/} are blocked."
      echo "Create a working branch and merge through a pull request."
      failed=1
      ;;
    refs/heads/*)
      branch_name="${remote_ref#refs/heads/}"

      if ! printf '%s\n' "$branch_name" | grep -Eq "$branch_pattern"; then
        echo "Invalid branch name: $branch_name"
        echo "Use feature/*, fix/*, refactor/*, or docs/* with lowercase kebab-case names."
        failed=1
      fi
      ;;
  esac
done

if [ "$failed" -ne 0 ]; then
  exit 1
fi
